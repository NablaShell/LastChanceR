// ui/components/header.slint
import { Theme } from "../theme.slint";

export component CustomHeader inherits Rectangle {
    in property <string> title: "Not LastChance";
    callback minimize-clicked();
    callback close-clicked();
    callback drag-started();

    height: 35px;
    background: #0a0a0fcc;
    border-width: 0px;

    // Нижняя граница как отдельный Rectangle
    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: #ffffff1a;
    }

    HorizontalLayout {
        // Drag zone
        drag-area := TouchArea {
            horizontal-stretch: 1;
            height: 100%;
            mouse-cursor: grab;
            moved => { drag-started(); }

            Text {
                text: root.title;
                color: #ffffff99;
                font-size: 12px;
                letter-spacing: 1px;
                vertical-alignment: center;
                x: 15px;
            }
        }

        // Window controls
        HorizontalLayout {
            spacing: 0px;

            min-btn := Rectangle {
                width: 46px;
                height: 100%;
                background: min-touch.pressed ? #ffffff14 : transparent;
                min-touch := TouchArea {
                    clicked => { minimize-clicked(); }
                }
                Text {
                    text: "—";
                    color: #ffffffb3;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            close-btn := Rectangle {
                width: 46px;
                height: 100%;
                background: close-touch.pressed ? #e81123 : transparent;
                close-touch := TouchArea {
                    clicked => { close-clicked(); }
                }
                Text {
                    text: "✕";
                    color: #ffffffb3;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
