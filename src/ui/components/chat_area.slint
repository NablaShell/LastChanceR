// ui/components/chat_area.slint
import { Theme } from "../theme.slint";
import { MessageBubble } from "message_bubble.slint";
import { ScrollView } from "std-widgets.slint";

export struct MessageItem {
    id: string,
    text: string,
    is-own: bool,
    time: string,
    is-file: bool,
    file-name: string,
    file-hash: string,
    file-hash-truncated: string,
    file-size: string,
}

export component ChatArea inherits Rectangle {
    in property <[MessageItem]> messages: [];
    in property <string> selected-id: "";
    in property <string> selected-name: "";
    in property <string> input-value: "";
    in property <bool> is-uploading: false;

    callback input-changed(string);
    callback send();
    callback attach();
    callback download-file(string, string);
    callback copy-text(string);

    background: transparent;

    VerticalLayout {
        spacing: 8px;

        // ----- Header -----
        if selected-id != "" : Rectangle {
            height: 62px;
            border-radius: 16px;
            background: #0f0a1ab3;
            border-width: 1px;
            border-color: Theme.glass-border;

            HorizontalLayout {
                padding: 12px;
                spacing: 12px;

                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: #8b5cf633;

                    Text {
                        text: "👤";
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: selected-name;
                        color: white;
                        font-size: 17px;
                        font-weight: 600;
                    }

                    Text {
                        text: selected-id;
                        color: Theme.text-secondary;
                        font-size: 12px;
                        font-family: "monospace";
                        overflow: elide;
                    }
                }
            }
        }

        // ----- Messages -----
        if selected-id != "" : ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding-top: 20px;
                padding-bottom: 20px;
                padding-left: 24px;
                padding-right: 24px;
                spacing: 12px;

                if messages.length == 0 : VerticalLayout {
                    alignment: center;

                    Text {
                        text: "No messages yet";
                        color: Theme.text-secondary;
                        font-size: 14px;
                        horizontal-alignment: center;
                    }
                }

                for msg in messages : MessageBubble {
                    text: msg.text;
                    is-own: msg.is-own;
                    time: msg.time;
                    is-file: msg.is-file;
                    file-name: msg.file-name;
                    file-hash: msg.file-hash;
                    file-hash-truncated: msg.file-hash-truncated;
                    file-size: msg.file-size;

                    download => {
                        root.download-file(msg.file-hash, msg.file-name);
                    }
                    copy-hash => {
                        root.copy-text(msg.file-hash);
                    }
                }
            }
        }

        // ----- Empty state -----
        if selected-id == "" : Rectangle {
            vertical-stretch: 1;
            background: transparent;

            VerticalLayout {
                alignment: center;
                spacing: 12px;

                Text {
                    text: "👤";
                    font-size: 64px;
                    horizontal-alignment: center;
                    opacity: 0.3;
                }

                Text {
                    text: "No contact selected";
                    color: Theme.text-secondary;
                    font-size: 20px;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Add a contact or select one from the list";
                    color: Theme.text-muted;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
            }
        }

        // ----- Input -----
        if selected-id != "" : Rectangle {
            height: 62px;
            border-radius: 16px;
            background: #0f0a1ab3;
            border-width: 1px;
            border-color: Theme.glass-border;

            HorizontalLayout {
                padding: 8px;
                spacing: 12px;

                attach-btn := Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: 12px;
                    background: attach-touch.pressed ? #8b5cf626 : #ffffff0d;

                    attach-touch := TouchArea {
                        clicked => { attach(); }
                    }

                    Text {
                        text: "📎";
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                msg-input := TextInput {
                    horizontal-stretch: 1;
                    text: input-value;
                    color: Theme.text-primary;
                    font-size: 15px;
                    single-line: true;
                    vertical-alignment: center;
                    edited => { root.input-changed(self.text); }
                    accepted => { root.send(); }
                }

                send-btn := Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: 12px;
                    background: send-touch.pressed ? #6366f14d : #6366f126;

                    send-touch := TouchArea {
                        clicked => { send(); }
                    }

                    Text {
                        text: "➤";
                        color: Theme.primary-light;
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
