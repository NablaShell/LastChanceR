// ui/components/message_bubble.slint
import { Theme } from "../theme.slint";

export component MessageBubble inherits Rectangle {
    in property <string> text;
    in property <bool> is-own;
    in property <string> time;
    in property <bool> is-file: false;
    in property <string> file-name;
    in property <string> file-hash;
    in property <string> file-hash-truncated;
    in property <string> file-size;

    callback download();
    callback copy-hash();

    background: transparent;

    HorizontalLayout {
        alignment: is-own ? end : start;

        bubble := Rectangle {
            max-width: 480px;
            border-radius: 20px;
            background: is-own
                ? Theme.message-gradient
                : #ffffff14;
            border-width: is-own ? 0px : 1px;
            border-color: is-own ? transparent : #8b5cf633;

            VerticalLayout {
                padding-top: 10px;
                padding-bottom: 10px;
                padding-left: 14px;
                padding-right: 14px;
                spacing: 6px;

                // ----- File message -----
                if is-file : VerticalLayout {
                    spacing: 4px;

                    Text {
                        text: file-name;
                        color: is-own ? white : Theme.text-primary;
                        font-size: 14px;
                        font-weight: 500;
                        wrap: word-wrap;
                    }

                    if file-size != "" : Text {
                        text: file-size;
                        color: is-own ? #ffffffb3 : Theme.text-secondary;
                        font-size: 11px;
                    }

                    // Hash row
                    Rectangle {
                        background: is-own ? #ffffff1a : #00000033;
                        border-radius: 8px;
                        height: 22px;

                        HorizontalLayout {
                            padding-top: 4px;
                            padding-bottom: 4px;
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            alignment: start;

                            Text {
                                text: file-hash-truncated;
                                color: #ffffff99;
                                font-size: 10px;
                                font-family: "monospace";
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            copy-touch := TouchArea {
                                width: 16px;
                                height: 16px;
                                clicked => { root.copy-hash(); }

                                Text {
                                    text: "📋";
                                    font-size: 10px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // "File sent" badge (own)
                    if is-own : Rectangle {
                        background: #48bb7833;
                        border-radius: 8px;
                        height: 26px;

                        HorizontalLayout {
                            padding-top: 6px;
                            padding-bottom: 6px;
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: center;

                            Text {
                                text: "✓ File sent";
                                color: Theme.success-light;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // "Download file" button (not own)
                    if !is-own : Rectangle {
                        background: #8b5cf633;
                        border-radius: 8px;
                        height: 28px;
                        width: 140px;

                        dl-touch := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => { root.download(); }
                        }

                        HorizontalLayout {
                            padding-top: 6px;
                            padding-bottom: 6px;
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: center;

                            Text {
                                text: "⬇";
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "Download file";
                                color: #c4b5fd;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // ----- Text message -----
                if !is-file : Text {
                    text: text;
                    color: is-own ? white : Theme.text-primary;
                    font-size: 14px;
                    wrap: word-wrap;
                }

                Text {
                    text: time;
                    color: is-own ? #ffffff99 : Theme.text-secondary;
                    font-size: 11px;
                    horizontal-alignment: right;
                }
            }
        }
    }
}
