// ui/components/add_contact_modal.slint
import { Theme } from "../theme.slint";

export component AddContactModal inherits Rectangle {
    in-out property <string> input: "";
    in property <string> error: "";
    in property <bool> loading: false;

    callback close();
    callback input-changed(string);
    callback submit();
    callback paste-from-clipboard();

    width: 100%;
    height: 100%;
    background: #00000099;

    overlay-touch := TouchArea { clicked => { close(); } }

    card := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 520px;
        height: min(content.preferred-height + 48px, parent.height * 0.9);
        border-radius: 18px;
        background: #0f0a1af2;
        border-width: 1px;
        border-color: #8b5cf64d;

        card-touch := TouchArea { }

        content := VerticalLayout {
            padding: 24px;
            spacing: 16px;

            HorizontalLayout {
                Text {
                    text: "Add a contact";
                    color: white;
                    font-size: 20px;
                    font-weight: 600;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }

                close-btn := Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: close-t.pressed ? #ffffff1a : transparent;

                    close-t := TouchArea { clicked => { close(); } }

                    Text {
                        text: "✕";
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Text {
                text: "Paste link, JSON or enter manually";
                color: Theme.text-secondary;
                font-size: 13px;
            }

            Rectangle {
                background: #ffffff0d;
                border-radius: 12px;
                border-width: 1px;
                border-color: #8b5cf64d;
                height: 100px;

                input-area := TextInput {
                    x: 12px;
                    y: 12px;
                    width: parent.width - 24px;
                    height: parent.height - 24px;
                    text: root.input;
                    color: Theme.text-primary;
                    font-size: 13px;
                    single-line: false;
                    wrap: word-wrap;
                    edited => {
                        root.input = self.text;
                        root.input-changed(self.text);
                    }
                }

                paste-btn := Rectangle {
                    x: parent.width - self.width - 8px;
                    y: parent.height - self.height - 8px;
                    width: 72px;
                    height: 28px;
                    border-radius: 8px;
                    background: paste-t.pressed ? #8b5cf64d : #8b5cf633;

                    paste-t := TouchArea {
                        clicked => { paste-from-clipboard(); }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: center;
                        Text { text: "📋"; font-size: 12px; }
                        Text {
                            text: "Paste";
                            color: Theme.accent-light;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if error != "" : Rectangle {
                background: #ef44441a;
                border-radius: 12px;
                border-width: 1px;
                border-color: #ef444433;

                VerticalLayout {
                    padding: 10px;
                    Text {
                        text: error;
                        color: Theme.danger-light;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                cancel-btn := Rectangle {
                    width: 100px;
                    height: 38px;
                    border-radius: 12px;
                    background: cancel-t.pressed ? #ffffff14 : #ffffff0d;

                    cancel-t := TouchArea { clicked => { close(); } }

                    Text {
                        text: "Cancel";
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                submit-btn := Rectangle {
                    width: 120px;
                    height: 38px;
                    border-radius: 12px;
                    background: submit-t.pressed
                        ? #4f46e5
                        : Theme.message-gradient;

                    submit-t := TouchArea {
                        clicked => {
                            if !loading { submit(); }
                        }
                    }

                    Text {
                        text: loading ? "..." : "Добавить";
                        color: white;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
